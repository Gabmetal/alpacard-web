{
  "info": {
    "name": "Alpacard API Test Suite (Auto-Configured)",
    "description": "Comprehensive integration test suite with automatic token extraction and environment variable updates across all test steps.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "ownerToken", "value": "" },
    { "key": "guestToken", "value": "" },
    { "key": "businessId", "value": "" },
    { "key": "campaignId", "value": "" },
    { "key": "cardId", "value": "" },
    { "key": "qrToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health & Telemetry",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Service reports healthy', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.status).to.eql('healthy');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        },
        {
          "name": "Prometheus Metrics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/metrics"
          }
        }
      ]
    },
    {
      "name": "2. Auth Flow",
      "item": [
        {
          "name": "Register Owner",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate random email to avoid duplicate errors on re-runs",
                  "var randomSuffix = Math.floor(Math.random() * 100000);",
                  "pm.environment.set('ownerEmail', 'owner_' + randomSuffix + '@alpaca.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    pm.environment.set('ownerToken', data.token);",
                  "    pm.collectionVariables.set('ownerToken', data.token);",
                  "    console.log('Saved ownerToken:', data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carlos Merchant\",\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"OWNER\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.environment.set('ownerToken', data.token);",
                  "    pm.collectionVariables.set('ownerToken', data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Guest Login (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    pm.environment.set('guestToken', data.token);",
                  "    pm.collectionVariables.set('guestToken', data.token);",
                  "    console.log('Saved guestToken:', data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/guest"
          }
        },
        {
          "name": "Get Profile (/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        }
      ]
    },
    {
      "name": "3. Business Management",
      "item": [
        {
          "name": "Create Business",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    pm.environment.set('businessId', data.id);",
                  "    pm.collectionVariables.set('businessId', data.id);",
                  "    console.log('Saved businessId:', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Café Alpaca Central\",\n  \"brandColor\": \"#3D2B1F\",\n  \"category\": \"Cafetería\",\n  \"description\": \"Café de especialidad\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/businesses"
          }
        },
        {
          "name": "List My Businesses",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }],
            "url": "{{baseUrl}}/api/v1/businesses/mine"
          }
        },
        {
          "name": "Get Business Dashboard Stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }],
            "url": "{{baseUrl}}/api/v1/businesses/{{businessId}}/stats"
          }
        }
      ]
    },
    {
      "name": "4. Campaigns",
      "item": [
        {
          "name": "Create Campaign",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    pm.environment.set('campaignId', data.id);",
                  "    pm.collectionVariables.set('campaignId', data.id);",
                  "    console.log('Saved campaignId:', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessId\": \"{{businessId}}\",\n  \"name\": \"Club del Café 8 Sellos\",\n  \"description\": \"Junta 8 sellos y llévate un café gratis\",\n  \"stampsRequired\": 8,\n  \"reward\": \"Café Gratis\",\n  \"bgType\": \"preset\",\n  \"bgValue\": \"espresso\",\n  \"textColor\": \"#ffffff\",\n  \"stampIcon\": \"coffee\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/campaigns"
          }
        },
        {
          "name": "List Campaigns (Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/campaigns?businessId={{businessId}}"
          }
        }
      ]
    },
    {
      "name": "5. Cards & QR Flow",
      "item": [
        {
          "name": "Claim Card (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Card claimed successfully', function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    pm.environment.set('cardId', data.id);",
                  "    pm.collectionVariables.set('cardId', data.id);",
                  "    console.log('Saved cardId:', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{guestToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campaignId\": \"{{campaignId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/cards/claim"
          }
        },
        {
          "name": "Get Card Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{guestToken}}" }],
            "url": "{{baseUrl}}/api/v1/cards/{{cardId}}"
          }
        },
        {
          "name": "Get Dynamic Card QR Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.environment.set('qrToken', data.token);",
                  "    pm.collectionVariables.set('qrToken', data.token);",
                  "    console.log('Saved dynamic qrToken:', data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{guestToken}}" }],
            "url": "{{baseUrl}}/api/v1/cards/{{cardId}}/qr"
          }
        }
      ]
    },
    {
      "name": "6. Cashier Scanner & Anti-Fraud",
      "item": [
        {
          "name": "Verify & Add Stamp (Scan)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Stamp added or reward redeemed', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.success).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{qrToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/scan"
          }
        },
        {
          "name": "Replay Attack Test (Rescan Same QR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Replay attack rejected with 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{qrToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/scan"
          }
        }
      ]
    }
  ]
}
